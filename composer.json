{
  "name": "rotdrop/php-to-typescript",
  "description": "PHP to TypeScript conversion for Nextcloud apps and the RotDrop toolkit",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.2",
    "spatie/typescript-transformer": "^2.5",
    "phpdocumentor/type-resolver": "^1.6.2",
    "symfony/console": "^7.0",
    "symfony/finder": "^7.0"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "cweagans/composer-patches": "^2.0",
    "nextcloud/ocp": "dev-stable33 || dev-stable34 || dev-stable35",
    "phpunit/phpunit": "^11.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "cweagans/composer-patches": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCP\\": "vendor/nextcloud/ocp/OCP/"
    }
  },
  "extra": {
    "patches": {
      "nextcloud/ocp": {
        "Fix server version at 35.0.0.0": "composer-patches/nextcloud/ocp/get-version.patch"
      }
    },
    "bamarni-bin": {
      "bin-links": false,
      "target-directory": "vendor-bin",
      "forward-command": true
    }
  },
  "autoload": {
    "psr-4": {
      "OCA\\RotDrop\\DevScripts\\PhpToTypeScript\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "vendor-bin/phpcs/vendor/bin/phpcs --standard=.phpcs.xml src",
    "phpmd": "vendor-bin/phpmd/vendor/bin/phpmd src --format text --ruleset .phpmd.xml --no-progress"
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/composer.lock"
    ]
  }
}
