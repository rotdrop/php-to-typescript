{
  "name": "rotdrop/php-to-typescript",
  "description": "PHP to TypeScript conversion for Nextcloud apps and the RotDrop toolkit",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.2",
    "spatie/typescript-transformer": "^2.5",
    "phpdocumentor/type-resolver": "^1.6.2",
    "symfony/console": "^7.0",
    "symfony/finder": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "OCA\\RotDrop\\DevScripts\\PhpToTypeScript\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/composer.lock"
    ]
  }
}
